{
  "name": "@selvakumaresra/specship",
  "version": "0.11.0",
  "description": "Supercharge Claude Code with semantic code intelligence. 94% fewer tool calls • 77% faster exploration • 100% local.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "specship": "./dist/bin/specship.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    ".claude-plugin",
    "commands",
    "agents",
    "hooks",
    "selectors.json"
  ],
  "scripts": {
    "build": "tsc && tsc -p src/designer/tsconfig.json && npm run copy-assets && npm run build:server && npm run build:web && node -e \"require('fs').chmodSync('dist/bin/specship.js', 0o755)\"",
    "build:server": "node scripts/build-server-bundle.mjs",
    "build:web": "node scripts/build-web-bundle.mjs",
    "preuninstall": "node dist/bin/uninstall.js",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql');fs.mkdirSync('dist/extraction/wasm',{recursive:true});fs.readdirSync('src/extraction/wasm').filter(f=>f.endsWith('.wasm')).forEach(f=>fs.copyFileSync('src/extraction/wasm/'+f,'dist/extraction/wasm/'+f));try{fs.mkdirSync('dist/workflows/defaults',{recursive:true});fs.readdirSync('src/workflows/defaults').filter(f=>/\\.ya?ml$/i.test(f)).forEach(f=>fs.copyFileSync('src/workflows/defaults/'+f,'dist/workflows/defaults/'+f))}catch(e){}\"",
    "dev": "tsc --watch",
    "cli": "npm run build && node dist/bin/specship.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run __tests__/evaluation/",
    "eval": "npm run build && npx tsx __tests__/evaluation/runner.ts",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "sync:shim": "node scripts/sync-shim-version.mjs",
    "version": "npm run sync:shim",
    "release:shim": "node scripts/sync-shim-version.mjs && cd packages/specship-shim && npm publish --access public"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@fastify/cors": "^9.0.1",
    "commander": "^14.0.2",
    "cross-spawn": "^7.0.6",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.0",
    "fastify": "^4.28.1",
    "fflate": "^0.8.3",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.3",
    "sisteransi": "^1.0.5",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.25.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.30",
    "@types/picomatch": "^4.0.2",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  }
}
