<Article slug="adoption-wedge">
  <svg slot="figure" viewBox="0 0 980 440" preserveAspectRatio="xMidYMid slice">
    <defs><radialGradient id="haw" cx="50%" cy="22%" r="70%"><stop offset="0" stop-color="rgba(70,194,107,0.18)"/><stop offset="1" stop-color="rgba(70,194,107,0)"/></radialGradient></defs>
    <rect width="980" height="440" fill="url(#haw)"/>
    <!-- three rungs, ascending: wedge → health → deep end -->
