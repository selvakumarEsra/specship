---
/**
 * SpecShip landing page (LANDING-DOC).
 *
 * Reconciled to the Claude Design "SpecShip Landing.html" bundle (REQ-LANDING-001).
 * The design markup lives in `_landing-body.html` and its runtime in
 * `scripts/landing-runtime.js` — both generated from the bundle by
 * `.design-import/transform.mjs`, which also strips the designer instrumentation
 * and rewrites the design's placeholder/aspirational copy to shipped-0.9.0 truth
 * (REQ-LANDING-002): real npm install, real repo/docs links, live star count.
 * The page-scoped `landing.css` ships only here, so the design's full-bleed
 * layout never leaks into the Starlight docs.
 */
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '../styles/theme.css';
import '../styles/landing.css';
import { getStarsLabel } from '../lib/github';
import bodyRaw from './_landing-body.html?raw';
import runtimeJs from '../scripts/landing-runtime.js?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/selvakumarEsra/specship';
const npm = 'https://www.npmjs.com/package/@selvakumaresra/specship';
const install = 'npm i -g @selvakumaresra/specship';
const stars = await getStarsLabel();

// Fill the design body's placeholders with live values.
const body = bodyRaw
  .replaceAll('__BASE__', base)
  .replaceAll('__REPO__', repo)
  .replaceAll('__NPM__', npm)
  .replaceAll('__INSTALL__', install)
  .replaceAll('__STARS__', stars);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SpecShip — A knowledge graph for AI-assisted codebases</title>
    <meta
      name="description"
      content="SpecShip builds a live knowledge graph of your code, specs, and tests — so your AI coding agent explores structurally instead of re-reading files, your requirements never silently drift, and every token is accounted for. Local-first, MCP, for Claude Code."
    />
    <meta name="theme-color" content="#0B0D11" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="canonical" href="https://specship.cc/" />
    <!-- Set the theme before paint so there's no flash; honor the same key the docs use. -->
    <script is:inline>
      (function () {
        try {
          var k = 'starlight-theme';
          var saved = localStorage.getItem(k);
          var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (!saved) localStorage.setItem(k, theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={body} />

    <!-- Design runtime: nav-scroll state, copy buttons, scroll-reveal observer, stat counters. -->
    <script is:inline set:html={runtimeJs} />

    <!-- Light/dark toggle (the injected #themeBtn), persisted to the docs' theme key. -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('themeBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          var next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          try { localStorage.setItem('starlight-theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
