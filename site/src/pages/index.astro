---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '../styles/theme.css';
import LogoMark from '../components/LogoMark.astro';
import { getStarsLabel } from '../lib/github';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/selvakumarEsra/specship';
const npm = 'https://www.npmjs.com/package/@selvakumaresra/specship';
const stars = await getStarsLabel();
const install = 'npm i -g @selvakumaresra/specship';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}/favicon-180.png`} />
		<title>SpecShip — Workflow engine for AI coding agents</title>
		<meta
			name="description"
			content="Define multi-step development workflows in YAML — code review, bug fixes, feature implementation — and run them with one command. Isolated git worktrees, knowledge graph + spec linking, Claude Code analytics. Local-first."
		/>
		<meta property="og:title" content="SpecShip" />
		<meta property="og:description" content="Workflow engine for AI coding agents." />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
		<script is:inline>
			// Dark-first: matches the SpecShip Desktop default. Honor a saved
			// preference; otherwise pick dark unless the OS asks for light.
			(function () {
				try {
					var k = 'starlight-theme';
					var saved = localStorage.getItem(k);
					var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme;
					if (!saved) localStorage.setItem(k, theme);
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<div class="frame">
			<header class="nav">
				<a class="wordmark" href={`${base}/`}>
					<LogoMark size={26} />
					<span class="wordmark-text">SpecShip <span class="wordmark-sub">Desktop</span></span>
				</a>
				<nav class="nav-links">
					<a href={`${base}/getting-started/introduction`}>Docs</a>
					<a class="opt" href={`${base}/workflows/overview`}>Workflows</a>
					<a class="opt" href={`${base}/claude-code/overview`}>Claude Code</a>
					<a href={repo}>GitHub</a>
					<button class="theme-btn" type="button" aria-label="Toggle dark mode" id="themeBtn">
						<svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
							<circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
						</svg>
						<svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
							<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
						</svg>
					</button>
					<a class="star" href={`${repo}/stargazers`}>
						<span class="star-glyph" aria-hidden="true">★</span>{stars}
					</a>
				</nav>
			</header>

			<main>
				<!-- HERO -->
				<section class="hero">
					<div class="hero-left">
						<p class="eyebrow">Workflow engine · MCP · Local-first</p>
						<h1>
							<span class="h-accent">Spec-driven</span> AI coding,<br/>on rails.
						</h1>
						<p class="lede">
							Define multi-step development workflows in YAML — code review, bug fixes,
							feature implementation, testing — and run them with a single command.
							Each workflow runs in its own git worktree, backed by a knowledge graph
							of your code and specs.
						</p>
						<div class="cta">
							<a class="btn btn-primary" href={`${base}/getting-started/quickstart`}>Get started</a>
							<a class="btn btn-ghost" href={`${base}/workflows/overview`}>Read the workflow docs →</a>
						</div>
						<div class="install" data-install={install}>
							<code>{install}</code>
							<button class="copy" type="button" aria-label="Copy install command">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
									<rect x="9" y="9" width="11" height="11" />
									<path d="M5 15V5a1 1 0 0 1 1-1h9" />
								</svg>
							</button>
						</div>
					</div>
					<div class="hero-right">
						<div class="yaml-frame">
							<header class="yaml-head">
								<span class="dots"><i></i><i></i><i></i></span>
								<span class="yaml-name">workflows/spec-implement.yaml</span>
							</header>
							<pre class="yaml"><code>{`name: spec-implement
description: Spec → plan → code → test → review

inputs:
  - { name: SPEC_ID, required: true }

isolation: worktree

steps:
  - id: plan
    runner: agent
    prompt: |
      Plan implementation for $SPEC_ID.
      Use specship_explore to find anchors.
    output: plan.md

  - id: implement
    runner: agent
    depends_on: [plan]
    prompt: file://plan.md
    output: diff.md

  - id: test
    runner: bash
    depends_on: [implement]
    command: pnpm test --filter affected

  - id: review
    runner: approval
    depends_on: [test]
    message: Approve merge?

  - id: merge
    runner: shell
    depends_on: [review]
    command: git merge --ff-only $WORKTREE
`}</code></pre>
						</div>
					</div>
				</section>

				<!-- 4 WORKFLOW SUB-PILLARS — each lit by one of the four node colors -->
				<section class="pillars">
					<article class="pillar" style="--p-color: var(--ss-node-spec);">
						<span class="pn">01</span>
						<h2>Repeatable</h2>
						<p>Package your best AI coding patterns as shareable YAML workflows. Check them into git; share them across your team.</p>
					</article>
					<article class="pillar" style="--p-color: var(--ss-node-code);">
						<span class="pn">02</span>
						<h2>Isolated</h2>
						<p>Each workflow runs in its own git worktree — no conflicts, no mess. Half-finished agent runs never touch your working tree.</p>
					</article>
					<article class="pillar" style="--p-color: var(--ss-node-test);">
						<span class="pn">03</span>
						<h2>Portable</h2>
						<p>Run from the CLI, the desktop web UI, or your GitHub Actions runners. Same YAML, same behaviour, three surfaces.</p>
					</article>
					<article class="pillar" style="--p-color: var(--ss-node-route);">
						<span class="pn">04</span>
						<h2>Composable</h2>
						<p>Chain nodes into DAGs with <code>depends_on</code>, loops, conditional branches, and approval gates. Real control flow, not just scripts.</p>
					</article>
				</section>

				<!-- 4 PRODUCT PILLARS -->
				<section class="products">
					<header class="prod-head">
						<p class="eyebrow">What ships</p>
						<h2>Four surfaces, one local SQLite.</h2>
					</header>
					<div class="prod-grid">
						<a class="prod" href={`${base}/workflows/overview`} style="--p-color: var(--ss-node-spec);">
							<header>
								<span class="prod-dot"></span>
								<h3>Workflows</h3>
							</header>
							<p>The YAML DAG runner. Bundled <code>spec-implement</code>, <code>spec-fix</code>, <code>spec-verify</code>, <code>spec-relink</code>, plus your own under <code>.specship/workflows/</code>.</p>
							<span class="link">Read workflow docs →</span>
						</a>
						<a class="prod" href={`${base}/specs/why-specs`} style="--p-color: var(--ss-node-code);">
							<header>
								<span class="prod-dot"></span>
								<h3>Specs</h3>
							</header>
							<p>Write requirements in Markdown with stable IDs. SpecShip links each spec to the code that implements it and carries link state — <code>verified</code>, <code>drifted</code>, <code>broken</code>, <code>orphaned</code>.</p>
							<span class="link">Read spec docs →</span>
						</a>
						<a class="prod" href={`${base}/core-concepts/knowledge-graph`} style="--p-color: var(--ss-node-test);">
							<header>
								<span class="prod-dot"></span>
								<h3>Graph</h3>
							</header>
							<p>Tree-sitter parsing across 20+ languages → SQLite knowledge graph with FTS5 search. Symbols, edges, framework routes, cross-language bridges. Live to the agent over MCP.</p>
							<span class="link">Read graph docs →</span>
						</a>
						<a class="prod" href={`${base}/claude-code/overview`} style="--p-color: var(--ss-node-route);">
							<header>
								<span class="prod-dot"></span>
								<h3>Claude Code</h3>
							</header>
							<p>Reads <code>~/.claude/projects/*.jsonl</code> in the background and surfaces Sessions, Memory hierarchy, file/tool/subagent Heatmaps, Costs &amp; cache, and a tips engine — all live in the desktop UI.</p>
							<span class="link">Read Claude Code docs →</span>
						</a>
					</div>
				</section>

				<!-- DASHBOARD SHOWCASE -->
				<section class="show">
					<header class="show-head">
						<p class="eyebrow">Desktop UI</p>
						<h2>One port, one process, every surface.</h2>
						<p class="show-sub">
							<code>specship serve --ui</code> boots Fastify + Angular on <code>http://127.0.0.1:4242</code>.
							Stat tiles, recent neighborhood mini-graph, tips, heatmap, prompt-cost rollup,
							cache analytics — every numeric respects the project picker and the time range.
						</p>
					</header>
					<figure class="show-fig">
						<img
							src="https://raw.githubusercontent.com/selvakumarEsra/specship/main/assets/screenshots/dashboard.png?v=1"
							alt="SpecShip desktop dashboard"
							loading="lazy"
						/>
					</figure>
				</section>

				<!-- QUICKSTART STRIP -->
				<section class="quick">
					<div class="quick-step">
						<span class="qn">1</span>
						<h3>Install</h3>
						<pre><code>npm i -g @selvakumaresra/specship</code></pre>
					</div>
					<div class="quick-step">
						<span class="qn">2</span>
						<h3>Wire up Claude Code</h3>
						<pre><code>specship install</code></pre>
					</div>
					<div class="quick-step">
						<span class="qn">3</span>
						<h3>Index a project</h3>
						<pre><code>cd your-repo
specship init -i</code></pre>
					</div>
					<div class="quick-step">
						<span class="qn">4</span>
						<h3>Run a workflow</h3>
						<pre><code>specship workflow run \
  spec-implement \
  --input SPEC_ID=REQ-AUTH-005</code></pre>
					</div>
				</section>
			</main>

			<footer class="foot">
				<a class="foot-mark" href={`${base}/`}>
					<LogoMark size={20} glow={false} />
					<span>SpecShip</span>
				</a>
				<nav class="foot-links">
					<a href={`${base}/getting-started/introduction`}>Docs</a>
					<a href={`${base}/workflows/overview`}>Workflows</a>
					<a href={`${base}/specs/why-specs`}>Specs</a>
					<a href={`${base}/claude-code/overview`}>Claude Code</a>
					<a href={repo}>GitHub</a>
					<a href={npm}>npm</a>
					<a href={`${repo}/blob/main/LICENSE`}>MIT</a>
				</nav>
			</footer>
		</div>

		<script>
			// Install-cmd copy
			const wrap = document.querySelector('.install');
			const btn = wrap?.querySelector('.copy');
			if (wrap && btn) {
				const original = btn.innerHTML;
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(wrap.getAttribute('data-install') || '');
						btn.innerHTML = '<span class="copied">Copied</span>';
						setTimeout(() => (btn.innerHTML = original), 1400);
					} catch {
						/* clipboard blocked */
					}
				});
			}

			// Theme toggle
			const tBtn = document.getElementById('themeBtn');
			tBtn?.addEventListener('click', () => {
				const cur = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
				const next = cur === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				document.documentElement.style.colorScheme = next;
				try { localStorage.setItem('starlight-theme', next); } catch {}
			});
		</script>

		<style>
			:global(html) { background: var(--ss-bg); }
			:global(body) {
				margin: 0;
				font-family: var(--ss-font-sans);
				color: var(--ss-ink);
				overflow-x: hidden;
				transition: background-color 0.18s ease, color 0.18s ease;
				font-feature-settings: 'cv01', 'cv03', 'ss03';
			}

			.frame {
				max-width: 1440px;
				margin: 0 auto;
				border: 1px solid var(--ss-rule);
				background: var(--ss-bg);
			}

			/* ---- NAV ---- */
			.nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.1rem 2rem;
				border-bottom: 1px solid var(--ss-rule);
			}
			.wordmark {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: var(--ss-ink);
				text-decoration: none;
			}
			.wordmark-text {
				font-family: var(--ss-font-sans);
				font-weight: 700;
				font-size: 1.22rem;
				letter-spacing: -0.018em;
				line-height: 1;
				padding-top: 1px;
			}
			.wordmark-sub {
				color: var(--ss-ink-3);
				font-weight: 500;
				margin-left: 0.15em;
			}
			.nav-links {
				display: flex;
				align-items: center;
				gap: 1.4rem;
			}
			.nav-links a {
				color: var(--ss-ink-2);
				text-decoration: none;
				font-size: 0.94rem;
				font-family: var(--ss-font-sans);
				font-weight: 500;
			}
			.nav-links a:not(.star):hover {
				color: var(--ss-ink);
			}
			.theme-btn {
				display: inline-flex; align-items: center; justify-content: center;
				border: 1px solid var(--ss-rule-strong); background: var(--ss-bg-2);
				padding: 0.42rem 0.55rem; cursor: pointer; color: var(--ss-ink-2);
			}
			.theme-btn:hover { color: var(--ss-accent); border-color: var(--ss-accent); }
			.theme-btn .sun { display: none; }
			.theme-btn .moon { display: inline; }
			:global([data-theme='dark']) .theme-btn .sun { display: inline; }
			:global([data-theme='dark']) .theme-btn .moon { display: none; }
			.star {
				display: inline-flex; align-items: center; gap: 0.4rem;
				border: 1px solid var(--ss-rule-strong); padding: 0.4rem 0.85rem;
				font-variant-numeric: tabular-nums; font-size: 0.88rem;
				background: var(--ss-bg-2);
			}
			.star:hover { background: var(--ss-bg-press); border-color: var(--ss-accent); }
			.star-glyph { font-size: 0.85em; color: var(--ss-accent); }

			/* ---- HERO ---- */
			.hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				border-bottom: 1px solid var(--ss-rule);
			}
			.hero-left {
				padding: 4.5rem 3rem 4rem;
				min-width: 0;
			}
			.eyebrow {
				font-family: var(--ss-font-sans);
				font-size: 0.74rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--ss-ink-3);
				margin: 0 0 1.4rem;
				font-weight: 600;
			}
			h1 {
				font-family: var(--ss-font-sans);
				font-size: clamp(2.4rem, 5.5vw, 4.4rem);
				line-height: 1.05;
				font-weight: 700;
				letter-spacing: -0.028em;
				margin: 0 0 1.6rem;
				overflow-wrap: break-word;
				color: var(--ss-ink);
			}
			.h-accent {
				background: linear-gradient(135deg, var(--ss-accent-2), var(--ss-node-code));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.lede {
				font-size: 1.16rem;
				line-height: 1.55;
				color: var(--ss-ink-2);
				max-width: 40ch;
				margin: 0 0 2.2rem;
			}
			.cta {
				display: flex;
				gap: 0.9rem;
				margin-bottom: 1.6rem;
				flex-wrap: wrap;
				align-items: center;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.78rem 1.5rem;
				font-size: 0.98rem;
				font-weight: 600;
				text-decoration: none;
				border: 1px solid var(--ss-rule-strong);
				transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
				font-family: var(--ss-font-sans);
			}
			.btn-primary {
				background: var(--ss-accent);
				color: #ffffff;
				border-color: var(--ss-accent);
			}
			.btn-primary:hover {
				background: var(--ss-accent-2);
				border-color: var(--ss-accent-2);
			}
			.btn-ghost {
				background: transparent;
				color: var(--ss-ink);
				border-color: var(--ss-rule-strong);
			}
			.btn-ghost:hover { background: var(--ss-bg-press); border-color: var(--ss-accent); }

			.install {
				display: inline-flex; align-items: center; gap: 0.5rem;
				border: 1px solid var(--ss-rule-strong);
				padding: 0.45rem 0.55rem 0.45rem 0.9rem;
				font-family: var(--ss-font-mono);
				font-size: 0.9rem;
				background: var(--ss-bg-2);
			}
			.install code { font-family: inherit; background: none; color: var(--ss-ink); }
			.copy {
				display: inline-flex; align-items: center; justify-content: center;
				border: none; background: transparent; cursor: pointer;
				padding: 0.25rem; color: var(--ss-ink-2);
			}
			.copy:hover { color: var(--ss-accent); }
			.copy :global(.copied) {
				font-family: var(--ss-font-sans); font-size: 0.8rem; padding: 0 0.2rem;
				color: var(--ss-accent-2);
			}

			.hero-right {
				border-inline-start: 1px solid var(--ss-rule);
				display: flex; align-items: center; justify-content: center;
				padding: 2.5rem;
				min-width: 0;
				background: var(--ss-bg-void);
				background-image: radial-gradient(
					circle at 1px 1px,
					var(--ss-rule) 1px,
					transparent 1px
				);
				background-size: 16px 16px;
			}
			.yaml-frame {
				width: 100%; max-width: 520px;
				border: 1px solid var(--ss-rule-strong);
				background: var(--ss-bg-2);
				box-shadow: 6px 6px 0 var(--ss-rule);
			}
			.yaml-head {
				display: flex; align-items: center; gap: 0.85rem;
				padding: 0.55rem 0.9rem;
				border-bottom: 1px solid var(--ss-rule);
				background: var(--ss-bg-elev);
			}
			.dots { display: inline-flex; gap: 5px; }
			.dots i {
				width: 9px; height: 9px;
				display: inline-block;
			}
			.dots i:nth-child(1) { background: var(--ss-node-test); }
			.dots i:nth-child(2) { background: var(--ss-node-route); }
			.dots i:nth-child(3) { background: var(--ss-node-spec); }
			.yaml-name {
				font-family: var(--ss-font-mono);
				font-size: 0.78rem;
				color: var(--ss-ink-3);
			}
			.yaml {
				margin: 0; padding: 1rem 1.1rem;
				font-family: var(--ss-font-mono);
				font-size: 0.82rem; line-height: 1.55;
				color: var(--ss-ink-2);
				white-space: pre;
				overflow-x: auto;
			}

			/* ---- PILLARS ---- */
			.pillars {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				border-bottom: 1px solid var(--ss-rule);
				background: var(--ss-bg-2);
			}
			.pillar {
				padding: 2.6rem 1.7rem;
				border-inline-end: 1px solid var(--ss-rule);
				position: relative;
			}
			.pillar:last-child { border-inline-end: 0; }
			.pillar::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 2px;
				background: var(--p-color);
				opacity: 0.6;
			}
			.pn {
				font-family: var(--ss-font-mono);
				font-size: 0.85rem;
				color: var(--p-color);
				font-weight: 600;
			}
			.pillar h2 {
				font-family: var(--ss-font-sans);
				font-size: 1.4rem;
				font-weight: 700;
				letter-spacing: -0.018em;
				margin: 0.4rem 0 0.8rem;
				color: var(--ss-ink);
				line-height: 1.15;
			}
			.pillar p {
				font-size: 0.95rem; line-height: 1.55;
				color: var(--ss-ink-2);
				margin: 0;
			}
			.pillar code {
				background: var(--ss-bg-press);
				border: 1px solid var(--ss-rule);
				font-family: var(--ss-font-mono); font-size: 0.85em;
				padding: 0.05em 0.4em;
				color: var(--ss-node-spec);
			}

			/* ---- PRODUCTS ---- */
			.products {
				padding: 4rem 3rem;
				border-bottom: 1px solid var(--ss-rule);
			}
			.prod-head { margin-bottom: 2.5rem; max-width: 40ch; }
			.prod-head h2 {
				font-family: var(--ss-font-sans);
				font-size: clamp(1.8rem, 3vw, 2.4rem);
				font-weight: 700;
				letter-spacing: -0.022em;
				margin: 0;
				line-height: 1.1;
				color: var(--ss-ink);
			}
			.prod-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1px;
				background: var(--ss-rule);
				border: 1px solid var(--ss-rule);
			}
			.prod {
				background: var(--ss-bg);
				padding: 2rem 1.8rem;
				text-decoration: none;
				color: inherit;
				display: flex; flex-direction: column;
				gap: 0.8rem;
				transition: background 0.12s ease;
				position: relative;
			}
			.prod:hover { background: var(--ss-bg-2); }
			.prod header {
				display: flex; align-items: center; gap: 0.85rem;
			}
			.prod-dot {
				width: 12px; height: 12px;
				background: var(--p-color);
				display: inline-block;
				flex-shrink: 0;
				box-shadow: 0 0 12px var(--p-color);
