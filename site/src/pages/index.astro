				color: var(--p-color);
				font-weight: 600;
			}
			.prod:hover .link { text-decoration: underline; text-underline-offset: 3px; }

			/* ---- SHOWCASE ---- */
			.show {
				padding: 4rem 3rem 3rem;
				border-bottom: 1px solid var(--ss-rule);
				background: var(--ss-bg-2);
			}
			.show-head { max-width: 56ch; margin-bottom: 2rem; }
			.show-head h2 {
				font-family: var(--ss-font-sans);
				font-size: clamp(1.8rem, 3vw, 2.4rem);
				font-weight: 700;
				letter-spacing: -0.022em;
				margin: 0 0 0.8rem;
				line-height: 1.1;
				color: var(--ss-ink);
			}
			.show-sub {
				font-size: 1.02rem; line-height: 1.6;
