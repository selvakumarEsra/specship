				background: var(--ss-bg);
				overflow: hidden;
			}
			.show-fig img { width: 100%; height: auto; display: block; }

			/* ---- QUICKSTART ---- */
			.quick {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				border-bottom: 1px solid var(--ss-rule);
			}
			.quick-step {
				padding: 2.2rem 1.7rem;
				border-inline-end: 1px solid var(--ss-rule);
			}
			.quick-step:last-child { border-inline-end: 0; }
			.qn {
				font-family: var(--ss-font-mono);
				font-size: 0.95rem;
				color: var(--ss-accent);
				font-weight: 600;
			}
			.quick-step h3 {
				font-family: var(--ss-font-sans);
				font-size: 1.12rem;
				font-weight: 700;
				margin: 0.4rem 0 0.9rem;
				color: var(--ss-ink);
				letter-spacing: -0.01em;
			}
			.quick-step pre {
				margin: 0;
				padding: 0.7rem 0.85rem;
				background: var(--ss-bg-2);
				border: 1px solid var(--ss-rule);
				font-family: var(--ss-font-mono);
				font-size: 0.8rem;
				color: var(--ss-ink);
				overflow-x: auto;
				line-height: 1.5;
			}

			/* ---- FOOTER ---- */
			.foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.4rem 2rem;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.foot-mark {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-family: var(--ss-font-sans);
				font-weight: 700;
				letter-spacing: -0.015em;
				color: var(--ss-ink);
				text-decoration: none;
			}
			.foot-links {
				display: flex; gap: 1.4rem;
				flex-wrap: wrap;
			}
			.foot-links a {
				color: var(--ss-ink-2);
				text-decoration: none;
				font-size: 0.88rem;
			}
			.foot-links a:hover { color: var(--ss-accent); }

			/* ---- ENTRANCE ---- */
			@media (prefers-reduced-motion: no-preference) {
				.hero-left > * {
					opacity: 0;
					transform: translateY(8px);
					animation: ss-in 0.55s ease forwards;
				}
				.hero-left > *:nth-child(1) { animation-delay: 0.04s; }
				.hero-left > *:nth-child(2) { animation-delay: 0.1s; }
				.hero-left > *:nth-child(3) { animation-delay: 0.16s; }
				.hero-left > *:nth-child(4) { animation-delay: 0.22s; }
				.hero-left > *:nth-child(5) { animation-delay: 0.28s; }
				@keyframes ss-in { to { opacity: 1; transform: none; } }
			}

			/* ---- RESPONSIVE ---- */
			@media (max-width: 1024px) {
				.pillars, .quick { grid-template-columns: repeat(2, 1fr); }
				.pillars .pillar:nth-child(2) { border-inline-end: 0; }
				.pillars .pillar:nth-child(1), .pillars .pillar:nth-child(2) {
					border-bottom: 1px solid var(--ss-rule);
				}
				.quick .quick-step:nth-child(2) { border-inline-end: 0; }
				.quick .quick-step:nth-child(1), .quick .quick-step:nth-child(2) {
					border-bottom: 1px solid var(--ss-rule);
				}
				.prod-grid { grid-template-columns: 1fr; }
			}
			@media (max-width: 860px) {
				.hero { grid-template-columns: 1fr; }
				.hero-right { border-inline-start: none; border-top: 1px solid var(--ss-rule); padding: 1.5rem 1.25rem; }
				.hero-left { padding: 2.5rem 1.25rem 2rem; }
				.pillars, .quick { grid-template-columns: 1fr; }
				.pillars .pillar, .quick .quick-step {
					border-inline-end: 0;
					border-bottom: 1px solid var(--ss-rule);
				}
				.pillars .pillar:last-child, .quick .quick-step:last-child { border-bottom: 0; }
				.products, .show { padding: 2.5rem 1.25rem; }
				.nav { padding: 1rem 1.25rem; }
				.nav-links { gap: 0.85rem; font-size: 0.86rem; }
				.nav-links .opt { display: none; }
				.star { display: none; }
				.wordmark-sub { display: none; }
				.foot { padding: 1.4rem 1.25rem; }
			}
