---
// Standalone blog layout — ports the Claude Design "SpecShip Blog" system
// (dark, graph-native, Geist). Self-contained: imports the design's three
// stylesheets in order (styles → landing override → blog) and is independent
// of the Starlight docs theme.
import '../styles/blog/styles.css';
import '../styles/blog/landing.css';
import '../styles/blog/blog.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'index' | 'article';
}
const { title, description = 'Field notes on shipping with AI coding agents — from the team building SpecShip.', variant = 'article' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/selvakumarEsra/specship';
const blog = `${base}/blog`;
const home = `${base}/`;
const install = `${base}/getting-started/installation`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0B0D11" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={variant === 'article' ? 'article' : 'website'} />
  <meta property="og:site_name" content="SpecShip" />
  <meta property="og:image" content="https://specship.cc/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://specship.cc/og.png" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;600;650;680;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="read-progress" id="progress"></div>
  <div class="page">

    {variant === 'index' ? (
      <nav class="nav scrolled" id="nav">
        <div class="wrap nav-inner">
          <a class="brand" href={home}>
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" style="filter:drop-shadow(0 0 9px rgba(91,147,242,0.35))">
              <defs>
                <linearGradient id="ssTile" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse"><stop stop-color="#12161E"/><stop offset="1" stop-color="#0B0D11"/></linearGradient>
                <linearGradient id="ssLead" x1="18" y1="11" x2="26" y2="21" gradientUnits="userSpaceOnUse"><stop stop-color="#6FA0F6"/><stop offset="1" stop-color="#5B93F2"/></linearGradient>
              </defs>
              <rect width="32" height="32" rx="7.2" fill="url(#ssTile)"/>
              <rect x="0.5" y="0.5" width="31" height="31" rx="6.7" fill="none" stroke="rgba(255,255,255,0.08)"/>
              <g transform="translate(4.6 4.6) scale(0.715)">
                <path d="M5 16 H11 M11 9 L23 16 L11 23" stroke="rgba(150,165,200,0.5)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <line x1="11" y1="9" x2="11" y2="23" stroke="rgba(150,165,200,0.4)" stroke-width="1.9" stroke-linecap="round"/>
                <circle cx="23" cy="16" r="3.6" fill="url(#ssLead)"/>
                <circle cx="11" cy="9" r="2.9" fill="#A586F5"/>
                <circle cx="11" cy="23" r="2.9" fill="#46C26B"/>
                <circle cx="5" cy="16" r="2.1" fill="#29D2BE"/>
              </g>
            </svg>
            <span class="word">SpecShip<span class="desk">&nbsp;Desktop</span></span>
          </a>
          <div class="nav-links">
            <a href={`${base}/getting-started/introduction`}>Docs</a>
            <a href={`${base}/workflows/overview`}>Workflows</a>
            <a href={`${base}/core-concepts/knowledge-graph`}>Graph</a>
            <a href={blog} style="color:var(--text-primary)">Blog</a>
          </div>
          <div class="nav-right">
            <a class="gh-chip" href={repo}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.36 1.11 2.94.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
              <span>GitHub</span>
            </a>
            <a class="btn btn-primary btn-sm" href={install}>Install</a>
          </div>
        </div>
      </nav>
    ) : (
      <nav class="nav scrolled art-nav" id="nav">
        <div class="wrap nav-inner">
          <a class="brand" href={home}>
            <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
              <defs>
                <linearGradient id="ssTile" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse"><stop stop-color="#12161E"/><stop offset="1" stop-color="#0B0D11"/></linearGradient>
                <linearGradient id="ssLead" x1="18" y1="11" x2="26" y2="21" gradientUnits="userSpaceOnUse"><stop stop-color="#6FA0F6"/><stop offset="1" stop-color="#5B93F2"/></linearGradient>
              </defs>
              <rect width="32" height="32" rx="7.2" fill="url(#ssTile)"/>
              <rect x="0.5" y="0.5" width="31" height="31" rx="6.7" fill="none" stroke="rgba(255,255,255,0.08)"/>
              <g transform="translate(4.6 4.6) scale(0.715)">
                <path d="M5 16 H11 M11 9 L23 16 L11 23" stroke="rgba(150,165,200,0.5)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <line x1="11" y1="9" x2="11" y2="23" stroke="rgba(150,165,200,0.4)" stroke-width="1.9" stroke-linecap="round"/>
                <circle cx="23" cy="16" r="3.6" fill="url(#ssLead)"/><circle cx="11" cy="9" r="2.9" fill="#A586F5"/>
                <circle cx="11" cy="23" r="2.9" fill="#46C26B"/><circle cx="5" cy="16" r="2.1" fill="#29D2BE"/>
              </g>
            </svg>
            <span class="word">SpecShip<span class="desk">&nbsp;Desktop</span></span>
          </a>
          <div class="art-nav-cta">
            <a class="btn btn-ghost btn-sm" href={blog}>All posts</a>
            <a class="btn btn-primary btn-sm" href={install}>Install</a>
          </div>
        </div>
      </nav>
    )}

    <slot />

    <footer class="foot">
      <div class="wrap"><div class="foot-bottom" style="margin-top:0;border-top:none;padding-top:0">
        <span class="meta">© 2026 SpecShip · runs 100% local</span>
        <a class="meta" href={blog} style="color:var(--text-secondary)">← All posts</a>
      </div></div>
    </footer>

  </div>

  <script is:inline>
    (function () {
      // reading-progress bar
      var bar = document.getElementById('progress');
      function onScroll() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        var p = max > 0 ? (h.scrollTop || document.body.scrollTop) / max : 0;
        if (bar) bar.style.width = (p * 100).toFixed(2) + '%';
      }
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // copy-link buttons
      document.querySelectorAll('[data-copy]').forEach(function (el) {
        el.addEventListener('click', function (e) {
          e.preventDefault();
          if (navigator.clipboard) navigator.clipboard.writeText(location.href);
          var old = el.innerHTML;
          el.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#46C26B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(function () { el.innerHTML = old; }, 1300);
        });
      });

      // reveal-on-scroll
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal:not(.in)').forEach(function (el) { io.observe(el); });

      // category filter (blog index only)
      var filters = document.getElementById('filters');
      if (filters) {
        filters.addEventListener('click', function (e) {
          var btn = e.target.closest('.filter-chip');
          if (!btn) return;
          var cat = btn.getAttribute('data-cat');
          filters.querySelectorAll('.filter-chip').forEach(function (c) { c.classList.toggle('active', c === btn); });
          document.querySelectorAll('.posts-grid .post').forEach(function (p) {
            var show = cat === 'all' || p.getAttribute('data-cat') === cat;
            p.classList.toggle('hidden', !show);
          });
        });
      }
    })();
  </script>
</body>
</html>
