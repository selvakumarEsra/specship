{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // Resolve the @specship/specship type imports against the repo's
    // freshly-built dist/ (the root `tsc` runs before build:server in
    // `npm run build`). Compile-time only — emitted JS keeps the bare
    // specifiers, resolved at runtime by the dynamic loader / installed
    // package. Without this the server build fails on a clean machine
    // (CI/Linux) with TS2307 because the package isn't in node_modules; it
    // only resolved on the maintainer's box via a global install.
    "baseUrl": ".",
    "paths": {
      "@specship/specship": ["../dist/index.d.ts"],
      "@specship/specship/*": ["../*"]
    }
  },
  "include": ["src/**/*"]
}
