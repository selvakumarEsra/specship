{
  "permissions": {
    "allow": [
      "mcp__specship__specship_explore",
      "mcp__specship__specship_search",
      "mcp__specship__specship_node",
      "mcp__specship__specship_callers",
      "mcp__specship__specship_callees",
      "mcp__specship__specship_impact",
      "mcp__specship__specship_files",
      "mcp__specship__specship_status",
      "mcp__specship__designer_session",
      "mcp__specship__designer_prompt",
      "mcp__specship__designer_ask",
      "mcp__specship__designer_list",
      "mcp__specship__designer_snapshot",
      "mcp__specship__designer_handoff",
      "mcp__specship__specship_maintainability",
      "mcp__specship__specship_fitness"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "specship sync --quiet",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --filter @lih/frontend typecheck 2>&1 | tail -10"
          },
          {
            "type": "command",
            "command": "pnpm --filter @lih/backend typecheck 2>&1 | tail -10"
          },
          {
            "type": "command",
            "command": "npm test 2>&1 | tail -40"
          },
          {
            "type": "command",
            "command": "test -f bun.lockb && echo \"bun\" || test -f pnpm-lock.yaml && echo \"pnpm\" || test -f yarn.lock && echo \"yarn\" || test -f package-lock.json && echo \"npm\" || echo \"unknown\""
          },
          {
            "type": "command",
            "command": "npm install 2>&1 | tail -15"
          },
          {
            "type": "command",
            "command": "git status --porcelain"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "specship sync --quiet"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "specship spec-nudge"
          }
        ]
      }
    ]
  }
}
